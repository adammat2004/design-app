# The API the browser talks to.
#
# `plan-api.ts` falls back to this exact value when the variable is unset, so a default
# local setup needs no `.env.local` at all — copy this file only if your API is somewhere
# other than localhost:3001.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Rendering rollout: development previews v2; production keeps legacy until visual sign-off.
# Override per browser with ?renderer=v2 or ?renderer=legacy. No plan data is changed.
# NEXT_PUBLIC_GARDEN_RENDERER=v2
