DATABASE_URL=postgres://garden:garden@localhost:5432/garden_studio
PORT=3001
WEB_ORIGIN=http://localhost:3000

# The design assistant. Leave the key blank and the assistant endpoint answers 503 and the chat
# panel says "unavailable" — everything else in the app, including the whole test suite, works
# without it. Never commit a real key; .env is gitignored.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Milliseconds. The TypeScript SDK takes ms, unlike the Python SDK's seconds.
ASSISTANT_TIMEOUT_MS=30000
# Set to false to switch the assistant off even when a key is present.
ASSISTANT_ENABLED=true

# Only read by `pnpm --filter @garden-studio/asset-tool generate`, which regenerates the plan's
# textures and sprites with an image model. The running app never uses it; leave blank.
OPEN_AI_API_KEY=

# Aerial mapping ("Find my property" on step 1). All optional: with nothing set, the imagery
# and geocoding endpoints answer 503 and the card on step 1 says aerial mapping is not set up.
#
# Any provider that serves Web Mercator raster tiles by {z}/{x}/{y} works — the mainstream
# satellite mosaics and the national orthophoto services alike. Tiles are proxied through this
# API by default (IMAGERY_DELIVERY=proxy), which keeps any key here and serves them same-origin.
# Set IMAGERY_DELIVERY=direct only for a provider whose terms forbid proxying; the template then
# goes to the browser as-is, so any token in it must be one the provider lets you restrict by URL.
#
# LICENSING: check before tracing. As of the Sept 2026 investigation, Mapbox, Google, Esri and
# MapTiler all restrict deriving vector data from their imagery to non-commercial use (Google
# forbids it outright). See the plan document for the details and the national alternatives.
IMAGERY_PROVIDER=
IMAGERY_TILE_TEMPLATE=
IMAGERY_RETINA_TEMPLATE=
IMAGERY_DELIVERY=proxy
IMAGERY_ATTRIBUTION=
IMAGERY_MIN_ZOOM=0
IMAGERY_MAX_ZOOM=19
IMAGERY_TILE_SIZE=256

# Address search. `nominatim` needs no key but has a strict usage policy (one request a second,
# identify the application, no autocomplete) and thin Eircode coverage; `esri` needs
# GEOCODING_API_KEY. Addresses are never stored or logged.
GEOCODING_PROVIDER=
GEOCODING_API_KEY=
GEOCODING_USER_AGENT=GardenStudio/0.1 (development)
