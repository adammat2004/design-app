DATABASE_URL=postgres://garden:garden@localhost:5432/garden_studio
PORT=3001
WEB_ORIGIN=http://localhost:3000

# The design assistant. Leave the key blank and the assistant endpoint answers 503 and the chat
# panel says "unavailable" — everything else in the app, including the whole test suite, works
# without it. Never commit a real key; .env is gitignored.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Milliseconds. The TypeScript SDK takes ms, unlike the Python SDK's seconds.
ASSISTANT_TIMEOUT_MS=30000
# Set to false to switch the assistant off even when a key is present.
ASSISTANT_ENABLED=true

# The strategic brief: the one model call on the *generation* path. With this off — which is the
# default, and what it is with this line absent — the design agent writes its own three briefs and
# generation is entirely deterministic. With it on, a model decides what each of the three concepts
# is for and how the requested spaces rank in it; everything spatial stays deterministic, because
# there is nowhere in a DesignBrief to put a coordinate.
#
# Off by default on purpose: step 4 generates the moment a user arrives on it, so a default-on call
# would spend on every visit. A model failure of any kind falls back to the deterministic brief and
# never fails a generation.
DESIGN_BRIEF_LLM=false

# Only read by `pnpm --filter @garden-studio/asset-tool generate`, which regenerates the plan's
# textures and sprites with an image model. The running app never uses it; leave blank.
OPEN_AI_API_KEY=
