{
  "name": "@garden-studio/ar-builder",
  "version": "0.0.1",
  "private": true,
  "description": "PlanDocument → ARScene. Pure: runs in the browser (the whole-garden preview) and in the API (the phone's scene). Depends on the schema and the contract; neither depends on it.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@garden-studio/ar-contract": "workspace:*",
    "@garden-studio/schema": "workspace:*",
    "earcut": "3.2.3",
    "polygon-clipping": "0.15.7"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
