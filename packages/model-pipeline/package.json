{
  "name": "@garden-studio/model-pipeline",
  "version": "0.0.1",
  "private": true,
  "description": "Turns a generated GLB into a library model: validated, metres, +Y up, base-centred, front +Z, simplified to budget, textures shrunk, meshopt-compressed. Node only (glTF-Transform, meshoptimizer, sharp, gltf-validator); used by apps/api and tools/assets, never by a browser.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "^0.22.0",
    "mikktspace": "^1.1.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.9"
  }
}
